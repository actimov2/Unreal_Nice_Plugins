# ============================================================================
# Unreal Engine generated / build output (NEVER commit these)
# ============================================================================
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vs/
.vsconfig

# Solution / project files (regenerated locally)
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Compiled module files
*.target
*.modules

# UE5 crash reports
CrashReportClient/

# ============================================================================
# OS files
# ============================================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================================
# Editor temp files
# ============================================================================
*.swp
*.swo
*~

# ============================================================================
# Allow .uproject, .uplugin, Source/, Content/, Config/ — those are committed
# ============================================================================
!*.uproject
!*.uplugin

# ============================================================================
# Third-party marketplace / Fab assets — imported locally for testing only.
# Re-import from Fab when needed; too large for git, not project-owned.
# ============================================================================
HostProject/Content/Fab/
HostProject/Content/Megaplant_Library/
HostProject/Content/Modular_Rural_Cabin/

# ============================================================================
# Local-only secrets
# ============================================================================
.env
.env.local
*.local

# ============================================================================
# Beads (bd) — track issues, ignore the local SQLite DB
# ============================================================================
.beads/db/
!.beads/issues/

# ============================================================================
# OMC runtime state — keep specs/plans/research, ignore ephemeral state/logs
# ============================================================================
.omc/state/
.omc/logs/
!.omc/specs/
!.omc/plans/
!.omc/research/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# OMC ephemeral state (per-machine, do not commit)
.omc/sessions/
.omc/project-memory.json
